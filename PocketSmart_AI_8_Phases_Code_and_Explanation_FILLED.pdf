%PreformattedPara
0 0 0 rg
BT 1 0 0 1 8 268.8 Tm /F3 7.2 Tf 9.2 TL (# main.py) Tj T* (from fastapi import FastAPI) Tj T* (from pydantic import BaseModel) Tj T*  T* (app = FastAPI\(title="PocketSmart AI"\)) Tj T*  T* (class PlannerRequest\(BaseModel\):) Tj T* (    budget: float) Tj T* (    preference: str = "") Tj T*  T* (@app.get\("/"\)) Tj T* (def home\(\):) Tj T* (    return {"message": "PocketSmart AI is running"}) Tj T*  T* (@app.post\("/generate-home"\)) Tj T* (def generate_home\(data: PlannerRequest\):) Tj T* (    return {) Tj T* (        "planner": "Home",) Tj T* (        "budget": data.budget,) Tj T* (        "preference": data.preference,) Tj T* (        "recommendation": "Generate budget-aware home recommendations") Tj T* (    }) Tj T*  T* (@app.post\("/generate-party"\)) Tj T* (def generate_party\(data: PlannerRequest\):) Tj T* (    return {"planner": "Party", "budget": data.budget}) Tj T*  T* (@app.post\("/generate-jewelry"\)) Tj T* (def generate_jewelry\(data: PlannerRequest\):) Tj T* (    return {"planner": "Jewelry", "budget": data.budget}) Tj T* ET
Q
q

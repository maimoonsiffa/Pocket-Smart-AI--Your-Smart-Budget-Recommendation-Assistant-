BT 1 0 0 1 8 176.8 Tm /F3 7.2 Tf 9.2 TL (# test_api.py) Tj T* (def validate_budget\(budget\):) Tj T* (    return isinstance\(budget, \(int, float\)\) and budget > 0) Tj T*  T* (def test_valid_budget\(\):) Tj T* (    assert validate_budget\(10000\) is True) Tj T*  T* (def test_invalid_budget\(\):) Tj T* (    assert validate_budget\(0\) is False) Tj T* (    assert validate_budget\(-500\) is False) Tj T*  T* (def test_planner_names\(\):) Tj T* (    planners = ["Home", "Party", "Jewelry"]) Tj T* (    assert len\(planners\) == 3) Tj T*  T* (if __name__ == "__main__":) Tj T* (    test_valid_budget\(\)) Tj T* (    test_invalid_budget\(\)) Tj T* (    test_planner_names\(\)) Tj T* (    print\("All basic tests passed."\)) Tj T* ET
